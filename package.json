{
  "name": "buildour-systems-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run catalog:build && npm run dev --workspace=@buildour/web",
    "build": "npm run build --workspace=@buildour/web",
    "start": "npm run start --workspace=@buildour/web",
    "lint": "npm run lint --workspace=@buildour/web",
    "test": "npm run test --workspace=@buildour/catalog",
    "catalog:build": "npm run build --workspace=@buildour/catalog && node packages/catalog/dist/cli.js",
    "catalog:validate": "npm run catalog:build"
  },
  "engines": {
    "node": ">=20"
  }
}